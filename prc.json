{
  "path": ".",
  "output": "./dump_out",
  "include": [
    "**/*"
  ],
  "exclude": [
    "**/node_modules/**",
    ".git/**",
    "**/.git/**",
    "dump_out/**"
  ],
  "max_symbols": 1000000,
  "chunk_prefix": "dump",
  "split_long_lines": false,
  "progress": true,
  "stats_file": "",
  "include_hidden": false,
  "concurrency": 1,
  "exclude_self": true,
  "format": "plain",
  "clear": {
    "enabled": false,
    "mode": "line"
  },
  "tree": {
    "enabled": true,
    "format": "ascii",
    "max_depth": 0,
    "include_sizes": true,
    "mode": "full"
  }
}
