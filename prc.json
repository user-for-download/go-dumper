{
  "path": ".",
  "output": "./dump_out",
  "include": [
    "**/*"
  ],
  "exclude": [
    ".git/**",
    "dump_out/**",
    "node_modules/**",
    "vendor/**",
    "target/**",
    "dist/**",
    "build/**",
    "*.exe",
    "*.dll",
    "*.so",
    "*.dylib",
    "*.zip",
    "*.tar",
    "*.gz",
    "*.png",
    "*.jpg",
    "*.jpeg",
    "*.gif",
    "*.pdf"
  ],
  "max_symbols": 1000000,
  "chunk_prefix": "dump",
  "split_long_lines": true,
  "progress": true,
  "stats_file": "dump_out/stats.json",
  "include_hidden": false,
  "concurrency": 1,
  "exclude_self": true,
  "format": "markdown",
  "clear": {
    "enabled": false,
    "mode": "line"
  },
  "tree": {
    "enabled": true,
    "format": "ascii",
    "max_depth": 0,
    "include_sizes": true,
    "mode": "full"
  }
}