{
  "path": ".",
  "output": "./dump_out",
  "include": [
    "**/*"
  ],
  "exclude": [
    ".git/**",
    "**/.git/**",
    "node_modules/**",
    "**/node_modules/**",
    "vendor/**",
    "**/vendor/**",
    "dist/**",
    "**/dist/**",
    "build/**",
    "**/build/**",
    "target/**",
    "**/target/**",
    "out/**",
    "**/out/**",
    "coverage/**",
    "**/coverage/**",
    ".next/**",
    "**/.next/**",
    ".cache/**",
    "**/.cache/**",
    "dump_out/**"
  ],
  "max_symbols": 1000000,
  "chunk_prefix": "dump",
  "split_long_lines": false,
  "progress": true,
  "stats_file": "",
  "include_hidden": false,
  "concurrency": 1,
  "exclude_self": true,
  "format": "plain",
  "tree": {
    "enabled": true,
    "format": "ascii",
    "max_depth": 0,
    "include_sizes": true,
    "mode": "full"
  }
}
